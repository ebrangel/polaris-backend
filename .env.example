# Copie para `.env` e preencha os valores locais. `.env` nunca é commitado (ver
# .gitignore) — em produção/CI as env vars são definidas diretamente pela
# orquestração e vencem o que estiver aqui (infrastructure/config.py: load_dotenv()
# usa override=False).
#
# `PROCESS_ROLE` não é lido por infrastructure/config.py — é lido direto em main.py
# para decidir entre `uvicorn main:app` (api, padrão) e `arq main.WorkerSettings`
# (worker). Não precisa estar no .env; normalmente é passado no ambiente do processo
# do worker.
# PROCESS_ROLE=worker

# --- Obrigatórias -------------------------------------------------------------------
CATALOG_DB_URL=postgresql+psycopg://user:pass@localhost:5432/catalogo
REDIS_URL=redis://localhost:6379/0
INTERNAL_TOKEN=troque-por-um-token-secreto

# --- connection_ref do catálogo (catalog/schemas/*.yaml) ----------------------------
# Cada `connection_ref: env:X` do catálogo espera a variável X definida aqui.
DW_VENDAS_PG_URL=postgresql+psycopg://user:pass@localhost:5432/dw_vendas
DW_VENDAS_ORACLE_URL=oracle+oracledb_async://user:pass@localhost:1521/?service_name=ORCL
APP_ESTOQUE_URL=postgresql+psycopg://user:pass@localhost:5432/app_estoque
ES_EVENTOS_URL=http://localhost:9200

# --- Opcionais (defaults entre parênteses) -------------------------------------------
# GIT_SHA=unknown
# QUERY_TIMEOUT_SECONDS=300.0     # timeout de uma consulta contra o datasource (worker)
# INLINE_WAIT_SECONDS=2.0         # quanto a API aguarda o job antes de devolver 202
# INLINE_WAIT_POLL_DELAY=0.1      # intervalo de poll da API pelo resultado inline
# CACHE_TTL_SECONDS=3600
# CACHE_MAX_ROWS=100000
# CACHE_MAX_PAYLOAD_BYTES=8388608
# DEFAULT_MAX_LIMIT=50000
# QUERY_POOL_SIZE=10             # pool de conexões por datasource (aberto pelo worker)
# FETCH_CHUNK_SIZE=1000          # linhas lidas do cursor por vez (teto de memória do worker)
# EXPORT_DIR=exports
# EXPORT_TTL_SECONDS=86400
# SLOW_QUERY_THRESHOLD_MS=2000
# REQUEST_RATE_LIMIT=100
# REQUEST_RATE_LIMIT_WINDOW_SECONDS=60
# MAX_QUEUE_DEPTH=100            # backpressure: fila cheia -> 429 para qualquer consulta
# LOG_LEVEL=INFO
