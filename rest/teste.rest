# Saída em CSV via negociação de conteúdo, para cliente programático
POST http://localhost:8000/v1/query HTTP/1.1
content-type: application/json
accept: text/csv
X-Roles: admin,financeiro

{
    "schema": "vendas",
    "dimensions": ["sigla_uf"],
    "measures": ["valor_total"]
}

