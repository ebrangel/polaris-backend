# Opção A — o mesmo JSON do POST, url-encoded (paridade total)
GET http://localhost:8000/v1/query
?query=%7B%22schema%22%3A%22vendas%22%2C%22dimensions%22%3A%5B%22sigla_uf%22%5D%7D

###
GET http://localhost:8000/v1/query
?schema=vendas
&dimensions=sigla_uf
&measures=valor_total


###
# Opção B — parâmetros planos, para curl e links de dashboard
GET http://localhost:8000/v1/query
?schema=vendas
&dimensions=sigla_uf,cargo
&measures=valor_total
&filter[sigla_uf][in]=SP,RJ
&order_by=valor_total.desc
&limit=100

###
# Saída em CSV (seção 2.3a) — parâmetro explícito, para link de download
GET http://localhost:8000/v1/query
?schema=vendas
&dimensions=sigla_uf,cargo
#&measures=valor_total
&format=csv

